  "objectClasses": [
    {
      "id": "repeater",
      "type": "zoidium:repeater/repeater",
      "name": "Repeater",
      "description": "Copies source objects by a fixed transform step.",
      "schemaVersion": 2
    },
    {
      "id": "linear-repeater",
      "type": "zoidium:repeater/linear-repeater",
      "name": "Linear Repeater",
      "description": "Copies source objects evenly between the first and last transform.",
      "schemaVersion": 2
    },
    {
      "id": "random-repeater",
      "type": "zoidium:repeater/random-repeater",
      "name": "Random Repeater",
      "description": "Copies source objects with deterministic random transforms inside ranges.",
      "schemaVersion": 2
    },
    {
      "id": "echo-repeater",
      "type": "zoidium:repeater/echo-repeater",
      "name": "Echo Repeater",
      "description": "Copies source objects from explicitly evaluated earlier frames.",
      "schemaVersion": 2
    },
    {
      "id": "twist",
      "type": "zoidium:repeater/twist",
      "name": "Twist",
      "description": "Twists descendant 3D meshes around the selected axis in the effector frame with selectable curve quality.",
      "schemaVersion": 1
    },
    {
      "id": "warp",
      "type": "zoidium:repeater/warp",
      "name": "Warp",
      "description": "Bends descendant 3D meshes with selectable curve quality, polygon density, and an optional falloff field.",
      "schemaVersion": 1
    },
    {
      "id": "voronoi-fracture",
      "type": "zoidium:repeater/voronoi-fracture",
      "name": "Voronoi Fracture",
      "description": "Shatters descendant closed meshes into seeded Voronoi fragments with optional cap faces.",
      "schemaVersion": 1
    },
    {
      "id": "plain",
      "type": "zoidium:repeater/plain",
      "name": "Plain",
      "description": "Field-weighted transforms for separate pieces and text characters.",
      "schemaVersion": 1
    },
    {
      "id": "delay",
      "type": "zoidium:repeater/delay",
      "name": "Delay",
      "description": "Seekable transform delay with bounded fixed-step history.",
      "schemaVersion": 1
    }
  ],
