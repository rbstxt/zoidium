{
  "schemaVersion": 1,
  "id": "material-plus",
  "name": "Material+",
  "author": "Zoidium",
  "version": "30",
  "kind": "material-pack",
  "description": "Adds Matcap, Node Material, Image+, physically based, and corrected-UV material extensions.",
  "materialTypes": [
    {
      "id": "matcap",
      "name": "Matcap Material",
      "description": "Applies a view-dependent Matcap texture to a 3D object."
    },
    {
      "id": "pbrplus",
      "name": "PBR+ Material",
      "description": "Applies a physically based material with texture maps for surface properties."
    },
    {
      "id": "uvcustom",
      "name": "UV Custom Material",
      "description": "Like Custom Material, with evenly spaced texture UVs on 3D Text and extruded shapes."
    },
    {
      "id": "nodes",
      "name": "Node Material",
      "description": "Bakes procedural node graphs into physically based surface maps."
    },
    {
      "id": "imageplus",
      "name": "Image+ Material",
      "description": "Image material with animated opacity and transparency."
    }
  ],
  "resources": [
