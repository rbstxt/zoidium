  "category": "NATIVE FX",
  "nativeEffects": [
    {
      "id": "radialblurspin",
      "name": "Radial Blur (Spin)",
      "description": "Applies a radial spin blur around an adjustable center.",
      "source": "./plugins/native-fx/effects/radialblurspin.js?v=23"
    },
    {
      "id": "colorcurves",
      "name": "Color Curves",
      "description": "Adjusts composite and RGB channels with a direct-manipulation curve editor.",
      "source": "./plugins/native-fx/effects/colorcurves.js?v=23",
      "requiresApis": [
        "propertyControls",
        "modules"
      ]
    },
    {
      "id": "echo",
      "name": "Echo",
      "description": "Composites explicitly evaluated earlier frames on an Adjustment layer with configurable opacity decay and blending.",
      "source": "./plugins/native-fx/effects/echo.js?v=23",
      "requiresApis": [
        "defineFrameSampler"
      ]
    },
    {
      "id": "dropshadow",
      "name": "Drop Shadow",
      "description": "Adds a colored, offset, blurred shadow behind the layer.",
      "source": "./plugins/native-fx/effects/dropshadow.js?v=23"
    },
    {
      "id": "timeoffset",
      "name": "Time Offset",
      "description": "Evaluates the layer at a deterministic time offset; on an Adjustment layer, time-shifts only the image fed into that layer.",
      "source": "./plugins/native-fx/effects/timeoffset.js?v=23"
    },
    {
      "id": "posterizetime",
      "name": "Posterize Time",
      "description": "Evaluates the layer on a deterministic lower frame-rate clock; on an Adjustment layer, quantizes only the image fed into that layer.",
      "source": "./plugins/native-fx/effects/posterizetime.js?v=23"
    },
    {
      "id": "timedisplacement",
      "name": "Time Displacement",
      "description": "Displaces each pixel in time by the luminance of a displacement map, sampled across bounded time slices.",
      "source": "./plugins/native-fx/effects/timedisplacement.js?v=23",
      "requiresApis": [
        "defineFrameSampler"
      ]
    },
    {
      "id": "ccwidetime",
      "name": "CC Wide Time",
      "description": "Blends forward and backward frame steps around the current time, averaged or accumulated.",
      "source": "./plugins/native-fx/effects/ccwidetime.js?v=23",
      "requiresApis": [
        "defineFrameSampler"
      ]
    },
    {
      "id": "timedifference",
      "name": "Time Difference",
      "description": "Shows the difference between the layer now and the layer at a time offset, with contrast and alpha modes.",
      "source": "./plugins/native-fx/effects/timedifference.js?v=23",
      "requiresApis": [
        "defineFrameSampler"
      ]
    },
    {
      "id": "colordiffkey",
      "name": "Color Difference Key",
      "description": "Keys green/blue screens with two partial mattes, levels for each, and matte inspection views.",
      "source": "./plugins/native-fx/effects/colordiffkey.js?v=23"
    },
    {
      "id": "advspill",
      "name": "Advanced Spill Suppressor",
      "description": "Removes key-color spill from foreground edges with Standard or Ultra suppression.",
      "source": "./plugins/native-fx/effects/advspill.js?v=23"
    },
    {
      "id": "keycleaner",
      "name": "Key Cleaner",
      "description": "Cleans keyed matte edges with chatter reduction, edge decontamination, and alpha contrast.",
      "source": "./plugins/native-fx/effects/keycleaner.js?v=23"
    },
    {
      "id": "linearcolorkey",
      "name": "Linear Color Key",
      "description": "Keys pixels by RGB, hue, or chroma distance to a key color with tolerance and softness.",
      "source": "./plugins/native-fx/effects/linearcolorkey.js?v=23"
    },
    {
      "id": "radiowaves",
      "name": "Radio Waves",
      "description": "Emits analytic concentric polygon waves from a producer point.",
      "source": "./plugins/native-fx/effects/radiowaves.js?v=23"
    },
    {
      "id": "beam",
      "name": "Beam",
      "description": "Draws a laser beam from a starting point to an ending point.",
      "source": "./plugins/native-fx/effects/beam.js?v=23"
    },
    {
      "id": "numbers",
      "name": "Numbers",
      "description": "Draws a deterministic number, timecode, date or hexadecimal value.",
      "source": "./plugins/native-fx/effects/numbers.js?v=23"
    },
    {
      "id": "timecode",
      "name": "Timecode",
      "description": "Displays the layer time as SMPTE timecode, frames or feet and frames.",
      "source": "./plugins/native-fx/effects/timecode.js?v=23"
    },
    {
      "id": "ccpageturn",
      "name": "CC Page Turn",
      "description": "Curls the layer like a turning page with an adjustable fold and paper back.",
      "source": "./plugins/native-fx/effects/ccpageturn.js?v=23"
    },
    {
      "id": "cardwipe",
      "name": "Card Wipe",
      "description": "Flips the layer away as a grid of 3D cards in a chosen order.",
      "source": "./plugins/native-fx/effects/cardwipe.js?v=23"
    },
    {
      "id": "ccpixelpolly",
      "name": "CC Pixel Polly",
      "description": "Breaks the layer into flying polygons under force and gravity.",
      "source": "./plugins/native-fx/effects/ccpixelpolly.js?v=23"
    },
    {
      "id": "radialshadow",
      "name": "Radial Shadow",
      "description": "Casts a soft radial shadow of the layer away from a point light source.",
      "source": "./plugins/native-fx/effects/radialshadow.js?v=23"
    },
    {
      "id": "smartmotionblur",
      "name": "Smart Motion Blur",
      "description": "Optical-flow motion blur that estimates per-pixel motion between neighboring frames. Use an Adjustment layer for motion from a layer's own transform.",
      "source": "./plugins/native-fx/effects/smartmotionblur.js",
      "requiresApis": [
        "defineFrameSampler",
        "modules",
        "gl"
      ]
    }
  ]
}
