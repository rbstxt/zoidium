{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Isolated community effect source manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "apiVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^community-[a-f0-9]{32}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "profile": {
      "const": "isolated-effects"
    },
    "sourceFormat": {
      "const": "guest-script-v1"
    },
    "entry": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[a-zA-Z0-9_-]+(?:[./][a-zA-Z0-9_-]+)*$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 240,
        "pattern": "^[a-zA-Z0-9_-]+(?:[./][a-zA-Z0-9_-]+)*$"
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^community-[a-f0-9]{32}-fx-[a-z][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "dataSchema": {
            "const": 1
          },
          "template": {
            "enum": [
              "identity-v1",
              "gain-v1"
            ]
          },
          "properties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "type": {
                  "enum": [
                    "number",
                    "boolean"
                  ]
                },
                "default": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              },
              "required": [
                "key",
                "label",
                "type",
                "default"
              ]
            }
          },
          "actions": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "ui": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "#/$defs/node"
            }
          }
        },
        "required": [
          "id",
          "name",
          "dataSchema",
          "template",
          "properties",
          "actions",
          "ui"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "apiVersion",
    "id",
    "name",
    "author",
    "version",
    "profile",
    "sourceFormat",
    "entry",
    "assets",
    "effects"
  ],
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "section",
            "label",
            "control",
            "button"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "children": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "property": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "section"
              }
            }
          },
          "then": {
            "required": [
              "children"
            ],
            "properties": {
              "children": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "control"
              }
            }
          },
          "then": {
            "required": [
              "property"
            ],
            "properties": {
              "property": {}
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "button"
              }
            }
          },
          "then": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {}
            }
          }
        }
      ]
    }
  }
}
