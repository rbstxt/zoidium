{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zoidium plugin manifest",
  "description": "The source manifest contract for a Zoidium plugin bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "author",
    "version"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "objectCategory": {
      "type": "string"
    },
    "effectCount": {
      "type": "integer",
      "minimum": 0
    },
    "groupCount": {
      "type": "integer",
      "minimum": 0
    },
    "objectClassParent": {
      "$ref": "#/definitions/objectClassParent"
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/effect"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/group"
      }
    },
    "nativeEffects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/nativeEffect"
      }
    },
    "materialTypes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/materialType"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/module"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/resource"
      }
    },
    "objectTypes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/objectType"
      }
    },
    "objectClasses": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/objectClass"
      }
    }
  },
  "anyOf": [
    {
      "required": ["effects"],
      "properties": {
        "effects": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "required": ["groups"],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "required": ["nativeEffects"],
      "properties": {
        "nativeEffects": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "required": ["materialTypes"],
      "properties": {
        "materialTypes": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "required": ["modules"],
      "properties": {
        "modules": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "required": ["objectTypes"],
      "properties": {
        "objectTypes": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "required": ["objectClasses"],
      "properties": {
        "objectClasses": {
          "type": "array",
          "minItems": 1
        }
      }
    }
  ],
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "shader", "preset"],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "shader": {
          "$ref": "#/definitions/source"
        },
        "preset": {
          "$ref": "#/definitions/source"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "preset"],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "preset": {
          "$ref": "#/definitions/source"
        },
        "shaders": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source"
          }
        }
      }
    },
    "nativeEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source"],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/source"
        }
      }
    },
    "materialType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "source": {
          "$ref": "#/definitions/source"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "source"],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "type": {
          "enum": ["text", "json", "image"]
        },
        "source": {
          "$ref": "#/definitions/source"
        }
      }
    },
    "objectClassParent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "number"
        }
      }
    },
    "objectType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "name", "type", "list"],
      "properties": {
        "target": {
          "const": "object3d"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "desc": {
          "type": "string"
        },
        "replace": {
          "$ref": "#/definitions/objectTypeReplacement"
        },
        "feature": {
          "type": "string"
        },
        "type": {
          "type": "number"
        },
        "list": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/objectTypeVariant"
          }
        }
      }
    },
    "objectTypeReplacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "number"
        }
      }
    },
    "objectTypeVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "data"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "pattern": "^zoidium:[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
            }
          ]
        },
        "data": {
          "type": "object"
        }
      }
    },
    "objectClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name"],
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "type": {
          "type": "string",
          "pattern": "^zoidium:[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "defaultData": {
          "type": "object"
        }
      }
    }
  }
}
