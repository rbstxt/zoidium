{
  "name": "zoidium",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Open-source toolkit for extending Clipmaker Gen3 (CM3)",
  "main": "main.js",
  "scripts": {
    "setup": "node tools/runtime-resources.js --setup",
    "start": "electron .",
    "web": "node tools/serve-with-resources.js --port=8123",
    "dev": "node tools/serve-with-resources.js --port=8123 --open",
    "build": "npm run build:web",
    "build:web": "node tools/build-web.js",
    "deploy": "npm run build && npx wrangler pages deploy ./dist/web",
    "build:plugin-bundles": "node tools/build-plugin-bundles.js",
    "check:plugin-bundles": "node tools/build-plugin-bundles.js --check",
    "pre-dist": "npm run build:plugin-bundles",
    "dist": "node tools/build-electron.js"
  },
  "build": {
    "appId": "com.zoidium.app",
    "productName": "Zoidium",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules{,/**/*}",
      "!dist{,/**/*}",
      "!README*",
      "!AGENTS.md"
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "compression": "^1.8.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "serve": "^14.2.6",
    "serve-handler": "^6.1.7"
  }
}
