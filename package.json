{
  "name": "zoidium",
  "version": "1.0.0",
  "description": "Offline Panzoid Clipmaker Gen3 mirror",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "npx serve . -p 8123",
    "dev": "npx serve . -p 8123 & sleep 1 && open http://localhost:8123",
    "build:plugin-bundles": "node tools/build-plugin-bundles.js",
    "check:plugin-bundles": "node tools/build-plugin-bundles.js --check",
    "pre-dist": "npm run build:plugin-bundles",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.zoidium.app",
    "productName": "Zoidium",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "fonts.png",
      "main.js",
      "pz.all-35.css",
      "about/**/*",
      "docs/**/*",
      "js/**/*",
      "effect/**/*",
      "effect-custom-bezier-editor/**/*",
      "material/**/*",
      "plugins/registry.json",
      "plugins/plugin-manager.js",
      "plugins/plugin-manager.css",
      "plugins/core-patches/**/*",
      "plugins/*/bundle.json",
      "plugins/*/locales/**/*",
      "worker/**/*",
      "assets/**/*",
      "fonts/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "compression": "^1.8.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "serve": "^14.2.6",
    "serve-handler": "^6.1.7"
  }
}
