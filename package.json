{
  "name": "zoidium",
  "version": "1.0.0",
  "author": "Zoidium",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "description": "Open-source toolkit for extending Clipmaker Gen3 (CM3)",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node tools/runtime-resources.js --setup",
    "desktop:start": "node tools/start-electron.js",
    "desktop:dev": "pnpm run desktop:start",
    "web": "node tools/serve-with-resources.js --port=8123",
    "dev": "node tools/serve-with-resources.js --port=8123 --open",
    "build": "pnpm run build:web",
    "prebuild:web": "pnpm run build:plugin-bundles",
    "build:web": "node tools/build-web.js",
    "deploy": "pnpm run build && pnpm exec wrangler pages deploy ./dist/web",
    "build:plugin-bundles": "node tools/build-plugin-bundles.js",
    "build:sprites": "node tools/build-particles-plus-sprites.js",
    "generate:pzicon-sheet": "node tools/generate-pzicon-sheet.js --png",
    "generate:afterclip": "node tools/build-afterclip-plugin.js",
    "generate:ccfx": "node tools/build-ccfx-plugin.js",
    "generate:alipfx": "node tools/build-alipfx-plugin.js",
    "new:plugin": "node tools/new-plugin.js",
    "check:plugin-manifests": "node tools/validate-plugin-manifests.js",
    "check:plugin-bundles": "node tools/build-plugin-bundles.js --check",
    "check:syntax": "node tools/check-syntax.js",
    "lint": "eslint .",
    "test": "node --test",
    "verify": "node tools/verify.js",
    "desktop:build": "pnpm run build:plugin-bundles && node tools/build-electron.js",
    "dist": "pnpm run desktop:build",
    "cm3:export": "node tools/cm3-snapshot.js export",
    "cm3:restore": "node tools/cm3-snapshot.js restore",
    "docs:dev": "pnpm --filter @zoidium/docs dev",
    "docs:build": "pnpm --filter @zoidium/docs build",
    "pack:community": "node tools/pack-community-plugin.js",
    "build:community-interpreter": "node tools/build-community-interpreter.js",
    "test:community-network": "node tools/community-network-suite.js",
    "test:preview-cache": "node tools/preview-cache-oracle.js",
    "check:preview-cache-approvals": "node tools/preview-cache-approvals.js",
    "test:community-desktop": "node tools/community-desktop-suite.js"
  },
  "build": {
    "appId": "com.zoidium.app",
    "productName": "Zoidium",
    "directories": {
      "output": "dist"
    },
    "artifactName": "Zoidium-${version}-${os}-${arch}.${ext}",
    "files": [
      "**/*",
      "!node_modules{,/**/*}",
      "!dist{,/**/*}",
      "!README*",
      "!AGENTS.md",
      "!site{,/**/*}"
    ],
    "fileAssociations": [
      {
        "ext": "pz",
        "name": "Zoidium Project",
        "role": "Editor",
        "mimeType": "application/x-zoidium-project"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "compression": "^1.8.1"
  },
  "devDependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "acorn": "8.15.0",
    "ajv": "^8.18.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.12",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "1.56.1",
    "quickjs-emscripten-core": "0.32.0",
    "serve": "^14.2.6",
    "serve-handler": "^6.1.7"
  }
}
