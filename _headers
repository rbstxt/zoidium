/*
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'
  X-Content-Type-Options: nosniff

/plugins/*/bundle.json
  Cache-Control: public, max-age=31536000, immutable

# Bundled fonts are stable file names that are not query-versioned. A one-week
# cache avoids revalidating them on every visit.
# The built-in preset fonts staged at assets/fonts/2d/ are stable too.
/fonts/*
  Cache-Control: public, max-age=604800

/assets/fonts/2d/*
  Cache-Control: public, max-age=604800

/assets/fonts/2d-variable/*
  Cache-Control: public, max-age=604800
